<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for antevemus/aspecification-redis-streams.

  Coverage is not configured by default so that the run does not require Xdebug or PCOV.

  The tests that need Redis (group redis: tests/Contract/RedisStreamsContractTest, tests/Integration,
  tests/Property, and the documentation blocks that talk to Redis) are opt-in and run against a Redis 7.4
  server for tests given by the environment:

    ASPEC_REDIS_HOST=127.0.0.1 ASPEC_REDIS_PORT=6379 ASPEC_REDIS_DATABASE=15 vendor/bin/phpunit

  for example with a container of its own:

    docker run -d (name aspec-redis-streams-test, port 127.0.0.1:16379 to 6379) redis:7.4-alpine
    ASPEC_REDIS_HOST=127.0.0.1 ASPEC_REDIS_PORT=16379 vendor/bin/phpunit

  Without ASPEC_REDIS_HOST, or when the server does not answer, they are skipped with the reason; with
  ASPEC_REDIS_REQUIRED=1 (the CI) a server that does not answer fails them. Each test writes under a
  prefix of keys of its own in database ASPEC_REDIS_DATABASE (default 15) and deletes its keys at the end.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnSkippedTests="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnRisky="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Property">
            <directory>tests/Property</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
